{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_hint.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/route_hint.py\" 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/due_reviews.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/due_reviews.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
